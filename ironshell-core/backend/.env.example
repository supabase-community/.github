# ══════════════════════════════════════════════════════════════════════════════
# IRONSHELL CORE ENGINE - ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (Free Tier Database)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER (Choose one)
# ─────────────────────────────────────────────────────────────────────────────
# Options: gemini, ollama, openai, anthropic
AI_PROVIDER=gemini

# Google Gemini (Free Tier - Recommended for $0 budget)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-flash

# Ollama (Local, Free, Private)
# Install from: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (Paid)
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (Paid)
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# ─────────────────────────────────────────────────────────────────────────────
# VECTOR STORE (Data Flywheel)
# ─────────────────────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chromadb
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=ironshell_corrections

# ─────────────────────────────────────────────────────────────────────────────
# GUARDRAILS (Liability Shield)
# Adjust these for your risk tolerance
# ─────────────────────────────────────────────────────────────────────────────
MAX_LEVERAGE=10.0
MAX_POSITION_SIZE_PERCENT=25.0
MAX_DAILY_LOSS_PERCENT=5.0
REQUIRE_STOP_LOSS=true

# ─────────────────────────────────────────────────────────────────────────────
# CORS (Update for production)
# ─────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
